      <aliases enabled='yes' />
      <column caption='Host status' datatype='string' name='[Calculation_1343103682252801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;=TODAY()THEN &quot;active host&quot;&#13;&#10;ELSE &quot;new host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price category' datatype='string' name='[Calculation_1343103682605058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Price]&gt;=300 then &quot;luxury&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;standard&quot;&#13;&#10;else &quot;budget&quot;&#13;&#10;END' />
      </column>
      <column caption='review category' datatype='string' name='[Calculation_1343103683137539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;=100 THEN &quot;high reviwed&quot;&#13;&#10;ELSE &quot;less reviwed&quot;&#13;&#10;END' />
      </column>
      <column caption='Price filter category' datatype='string' name='[Calculation_1343103684440069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1343103683502084]&#13;&#10;THEN &quot;above limit&quot;&#13;&#10;ELSE &quot;below limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Review performance score' datatype='integer' name='[Calculation_1343103684980742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]* [Review Scores Rating]' />
      </column>
      <column caption='Beds criteria' datatype='string' name='[Calculation_1343103688261641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Beds] &gt;     [Parameters].[Parameter 1343103687917576]&#13;&#10;THEN &quot;optimum number of beds&quot;&#13;&#10;ELSE &quot;not enough beds&quot;&#13;&#10;END' />
      </column>
      <column caption='Hotel count' datatype='integer' name='[Calculation_1343103690735626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Since_New' datatype='date' name='[Calculation_1343103692337163]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],&#13;&#10;DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Property type_New' datatype='string' name='[Calculation_1343103694364684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Property Type],&quot;unknown&quot;)' />
      </column>
